<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net45;netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>DreamPlace.Lib.Rx</RootNamespace>
    <AssemblyName>DreamPlace.Lib.Rx</AssemblyName>

    <!-- NuGet package -->
    <PackageId>RxRegistry</PackageId>
    <Version>0.2.0</Version>
    <Authors>Andrew Moryakov</Authors>
    <Description>Reactive Registry — in-memory storage with reactive subscriptions</Description>
    <PackageProjectUrl>https://github.com/AndrewMoryakov/RxRegistry</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>Reactive;Registry;Rx;RxRegistry</PackageTags>
  </PropertyGroup>

  <!-- Exclude other projects from auto-include -->
  <ItemGroup>
    <Compile Remove="DreamPlace.Libs.NetCore.Rx\**" />
    <Compile Remove="TestProject1\**" />
  </ItemGroup>

</Project>
